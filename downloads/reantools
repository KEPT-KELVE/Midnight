#!/usr/bin/python3
import os
import shutil
import subprocess
import sys

DONE = "Command Completed Successfully"
UNKNOWN = "The system cannot find the feature ID specified"
DENIED = "Access is denied. ReanTools needs administrator approval"
FEATURE = "/usr/local/sbin/midnight-feature"
# ReanTools keeps no list of feature IDs: midnightOS itself knows them (midnight-feature), so this file
# never needs replacing when new features are added; a ReanTools from today works with every later update.


def known(feature):
    """Ask the installed midnightOS whether it has this feature. True / False, or None when the system is
    older than the "check" question (then the switch itself decides)."""
    try:
        code = subprocess.run([FEATURE, "check", feature], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode
    except OSError:
        return False
    return True if code == 0 else False if code == 3 else None


def approved():
    """Admin Approval (midnight-uac) before any feature is switched; a terminal-only system asks through sudo."""
    if shutil.which("midnight-uac") and os.environ.get("DISPLAY"):
        try:
            return subprocess.run(["midnight-uac", "--ask", "--name", "ReanTools", "--icon", "utilities-terminal",
                                   "--reason", "app"]).returncode == 0
        except OSError:
            return False
    return subprocess.run(["sudo", "-v"]).returncode == 0


def main(args):
    here = os.path.dirname(os.path.realpath(__file__))
    if here != "/reantools" or len(args) != 2:
        return UNKNOWN
    action, target = args[0].lower(), args[1]
    if action not in ("/enable", "/disable") or not target.lower().startswith("/id:"):
        return UNKNOWN
    feature = target[4:]
    if not feature or known(feature) is False:
        return UNKNOWN
    if not approved():
        return DENIED
    switch = "on" if action == "/enable" else "off"
    try:
        result = subprocess.run(["sudo", "-n", FEATURE, switch, feature],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return UNKNOWN
    return DONE if result.returncode == 0 else UNKNOWN


print(main(sys.argv[1:]))
